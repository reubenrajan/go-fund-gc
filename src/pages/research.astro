---
import BaseLayout from '../layouts/BaseLayout.astro';
import products from '../data/products.json';
const unresolved = products.products.filter(p => p.status === 'RESEARCH_REQUIRED');
const alternatives = products.products.filter(p => p.status === 'ALTERNATIVE');
---
<BaseLayout title="Research Queue — Grace Chapel Plans & Projects">
<section class="detail-head"><div class="eyebrow">RESEARCH CONTROL</div><h1>VERIFY BEFORE PUBLISH.</h1><p class="muted">The research layer keeps procurement uncertainty visible. A source-level name is not the same as a verified selected product.</p></section>
<section class="section"><h2>Requires verification</h2><div class="grid">{unresolved.map(p=><div class="card"><span class="tag">{p.confidence}</span><h3>{p.manufacturer}</h3><p>{p.model}</p><p class="muted">{p.notes}</p></div>)}</div></section>
<section class="section"><h2>Alternatives</h2><div class="grid">{alternatives.map(p=><div class="card"><span class="tag">ALTERNATIVE</span><h3>{p.manufacturer}</h3><p>{p.model}</p><p class="muted">{p.notes}</p></div>)}</div></section>
</BaseLayout>
