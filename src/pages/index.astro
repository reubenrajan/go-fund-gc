---
import BaseLayout from '../layouts/BaseLayout.astro';
import projectData from '../data/projects.json';
import productData from '../data/products.json';
import funding from '../data/funding.json';
import { formatInr } from '../lib/progress.js';

const projects = projectData.projects;
const products = productData.products;
const fmt = (value) => value == null ? '—' : formatInr(value);
const pricedCurrent = projects.flatMap((p) => p.items).filter((x) => x.budget_inr != null && x.phase_group !== 'FUTURE' && !x.id.startsWith('power-'));
const phase1Target = pricedCurrent.filter((x) => x.id.startsWith('sound-') || x.id.startsWith('video-')).reduce((sum, x) => sum + x.budget_inr, 0);
const currentTarget = pricedCurrent.reduce((sum, x) => sum + x.budget_inr, 0);
const power45 = 690000;
const power58 = 780000;
const productByComponent = products.reduce((map, product) => { (map[product.component_id] ??= []).push(product); return map; }, {});
const fundingSlices = [
  { label: 'Sound System', project: 'sound-system' },
  { label: 'Videography', project: 'videography' },
  { label: 'Media', project: 'media' },
  { label: 'Air Cooling System', project: 'air-cooling' },
  { label: 'Security System', project: 'security-system' },
  { label: 'Church Building — Storage Room', project: 'church-building', filter: (item) => item.id === 'building-storage-room' },
  { label: 'Church Building — Roofing', project: 'church-building', filter: (item) => item.group === 'roofing' },
  { label: 'Church Building — Flooring', project: 'church-building', filter: (item) => item.group === 'flooring' }
];
const sliceTarget = (slice) => {
  const project = projects.find((p) => p.id === slice.project);
  const items = (project?.items ?? []).filter(slice.filter ?? (() => true));
  return items.reduce((sum, item) => sum + (item.budget_inr ?? 0), 0);
};
const church = projects.find((p) => p.id === 'church-building');
const churchGroups = [
  { title: 'Storage Room', subtitle: 'Built outside the church building. Priority.', items: church?.items.filter((i) => i.id === 'building-storage-room') ?? [] },
  { title: 'Roofing', subtitle: 'False ceiling and XLPE sheet insulation.', items: church?.items.filter((i) => i.group === 'roofing') ?? [] },
  { title: 'Flooring', subtitle: 'Ceramic, vinyl, clay floor tiles and Children’s Church grass mat.', items: church?.items.filter((i) => i.group === 'flooring') ?? [] }
];
---
<BaseLayout title="Grace Chapel — Plans & Projects" description="Grace Chapel Kannuru campus plans and projects. Consider supporting a project or part of a project as the Lord leads.">
<style>
  .public-nav{position:sticky;top:0;z-index:20;background:var(--surface);border-bottom:1px solid var(--line);padding:10px 0;display:flex;gap:8px;overflow:auto}.public-nav a{white-space:nowrap;border:1px solid var(--line);padding:8px 10px;font:10px ui-monospace,SFMono-Regular,Menlo,monospace;text-decoration:none;color:var(--muted)}.public-nav a:hover,.public-nav a:focus{background:var(--text);color:var(--surface)}
  .project-section{scroll-margin-top:84px}.project-block{border:1px solid var(--line);margin:18px 0;background:var(--surface)}.project-block>header{padding:22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;align-items:start}.project-block h3{font-size:32px;margin:0 0 8px;letter-spacing:-.04em}.project-meta{font:10px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted);text-transform:uppercase}
  .component{padding:24px;border-bottom:1px solid var(--line)}.component-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.component h4{font-size:24px;margin:0 0 8px}.component .product{font-size:15px;color:var(--text-soft);margin-bottom:12px}.small{font-size:12px;color:var(--muted);line-height:1.55}.money{font:24px ui-monospace,SFMono-Regular,Menlo,monospace}.specs{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}.spec,.pill{font:10px ui-monospace,SFMono-Regular,Menlo,monospace;border:1px solid var(--line);padding:5px 7px;color:var(--muted);text-transform:uppercase}.source{font:10px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted);margin-top:12px}.source a{text-decoration:underline;text-underline-offset:4px}
  .component-source-image{width:100%;height:220px;object-fit:contain;background:#f5f5f5;border:1px solid var(--line);display:block}.product-single{border:1px solid var(--line);padding:14px}.product-single img{width:100%;height:190px;object-fit:contain;background:#f5f5f5;display:block;margin-bottom:12px}.product-single h5{font-size:17px;margin:0 0 5px}.alternatives{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:14px}.alternative{border:1px solid var(--line);background:var(--surface);overflow:hidden}.alternative img{width:100%;height:220px;object-fit:contain;background:#f5f5f5;display:block}.alternative-body{padding:14px}.alternative h5{font-size:19px;margin:0 0 4px}.alternative summary{cursor:pointer;font:10px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted);text-transform:uppercase;margin-top:12px}.alternative ul{margin:12px 0 0;padding-left:18px;color:var(--text-soft);font-size:12px;line-height:1.55}
  .funding-intro{max-width:850px;color:var(--text-soft);font-size:18px;line-height:1.6}.macro-funding{border:1px solid var(--line);padding:28px;margin-top:24px}.funding-head{display:flex;justify-content:space-between;gap:20px;align-items:end}.funding-title{font-size:34px;letter-spacing:-.04em;margin:0}.funding-amount{font:28px ui-monospace,SFMono-Regular,Menlo,monospace}.funding-track,.micro-track{background:var(--line);position:relative;overflow:hidden}.funding-track{height:12px;margin:22px 0 12px}.funding-fill{height:100%;background:var(--text)}.funding-track.unknown:after{content:'OVERALL CONFIRMED FUNDING NOT YET CALCULABLE';position:absolute;inset:0;display:grid;place-items:center;font:9px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted);letter-spacing:.05em}.micro-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line);margin-top:18px}.micro-funding{background:var(--surface);padding:20px}.micro-funding h4{font-size:18px;margin:0 0 10px}.micro-track{height:7px;margin:12px 0 8px}.micro-track span{display:block;height:100%;background:var(--text)}.micro-meta{display:flex;justify-content:space-between;gap:12px;font:10px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted)}
  .phase-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin-top:18px}.phase-card{background:var(--surface);padding:20px}.phase-card h3{font-size:22px;margin:8px 0}.phase-card .amount{font:24px ui-monospace,SFMono-Regular,Menlo,monospace}.church-group{border:1px solid var(--line);margin-top:16px}.church-group>header{padding:20px;border-bottom:1px solid var(--line)}.church-group h3{margin:0 0 6px;font-size:25px}.material-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--line)}.material{background:var(--surface);padding:18px}.material img{width:100%;height:190px;object-fit:cover;background:#f5f5f5;margin-bottom:12px}.material h4{font-size:18px;margin:0 0 6px}.material .price{font:20px ui-monospace,SFMono-Regular,Menlo,monospace}.future-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.future-card{background:var(--surface);padding:20px;min-height:150px}.future-card h3{font-size:22px;margin:12px 0 8px}.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:22px 0}.toolbar input,.toolbar select{background:var(--control);color:var(--text);border:1px solid var(--line);padding:12px;font:12px ui-monospace,SFMono-Regular,Menlo,monospace}.toolbar input{min-width:260px;flex:1}.body-copy{font-size:19px;line-height:1.65;color:var(--text-soft);max-width:760px}.button-row{display:flex;gap:10px;flex-wrap:wrap}.empty{padding:30px;border:1px dashed var(--line);color:var(--muted)}
  @media(max-width:900px){.component-grid,.alternatives,.micro-grid,.material-grid,.future-grid,.phase-grid{grid-template-columns:1fr}.project-block>header{display:block}}
</style>

<section class="hero" id="top"><div class="eyebrow">GRACE CHAPEL / KANNURU CAMPUS</div><div class="hero-grid"><div><h1>HELP BUILD<br />THE HOUSE.</h1><p class="lede">See what Grace Chapel is working towards at Kannuru — from sound and media to cooling, security and the church building itself. If the Lord leads you, you can help fund a part of a project or an entire project.</p><div class="hero-actions"><a class="button primary" href="#funding">SEE WHAT YOU CAN SUPPORT ↓</a><a class="button" href="#projects">EXPLORE THE WORK ↓</a></div></div><div class="hero-mark" aria-hidden="true"><div class="crosshair"></div><span>GC / K</span></div></div></section>
<nav class="public-nav" aria-label="Page sections"><a href="#funding">FUNDING</a><a href="#projects">PROJECTS</a><a href="#building">CHURCH BUILDING</a><a href="#future">FUTURE</a><a href="#involvement">GET INVOLVED</a></nav>

<section class="section project-section" id="funding"><div class="section-head"><div><div class="eyebrow">YOUR GIVING CAN HELP</div><h2>OVERALL PROJECT FUNDING</h2></div><span class="mono muted">CONFIRMED FUNDING: —</span></div><p class="funding-intro">Every project can be supported in part or in full. We invite you to prayerfully consider where the Lord may be leading you to help. Planned costs are shown from the Grace Chapel Plans & Projects source. Confirmed giving is shown only where it has been reported.</p>
  <div class="macro-funding"><div class="funding-head"><div><div class="eyebrow">CURRENT PRICED WORK</div><h3 class="funding-title">Kannuru Plans & Projects</h3></div><div class="funding-amount">{fmt(currentTarget)}</div></div><div class="funding-track unknown"><div class="funding-fill" style="width:0%"></div></div><div class="micro-meta"><span>₹20,49,800 excludes the two alternative generator options</span><span>FUNDING PARTIAL</span></div></div>
  <div class="phase-grid"><div class="phase-card"><div class="eyebrow">PHASE 1</div><h3>Sound + Videography</h3><div class="amount">{fmt(phase1Target)}</div><p class="small">Sound System Phase 1: ₹5,60,000. Videography Phase 1: ₹1,70,000.</p></div><div class="phase-card"><div class="eyebrow">CURRENT PLANS</div><h3>Priced work</h3><div class="amount">{fmt(currentTarget)}</div><p class="small">Includes Phase 1 plus Media, Security and priced Church Building work. Air Cooling has no source cost.</p></div><div class="phase-card"><div class="eyebrow">POWER</div><h3>One generator option</h3><div class="amount">{fmt(power45)}–{fmt(power58)}</div><p class="small">45 kVA or 58.5 kVA. These are alternatives and must not be added together.</p></div></div>
  <div class="micro-grid">{fundingSlices.map((slice) => { const target = sliceTarget(slice); const air = slice.project === 'air-cooling'; const paid = air ? funding.components['cooling-evaporative-cooler']?.confirmed_percent : null; return <div class="micro-funding"><h4>{slice.label}</h4><div class="micro-meta"><span>{target ? 'Planned' : 'Planned cost'}</span><strong>{target ? fmt(target) : 'Not supplied'}</strong></div><div class="micro-track"><span style={`width:${paid ?? 0}%`}></span></div><div class="micro-meta"><span>{paid != null ? `${paid}% paid` : 'Giving update not reported'}</span><span>{paid != null ? 'CONFIRMED %' : '—'}</span></div></div> })}</div>
</section>

<section class="section project-section" id="projects"><div class="section-head"><div><div class="eyebrow">WHAT WE ARE WORKING TOWARDS</div><h2>PROJECTS</h2></div><span class="mono muted">CURRENT + FUTURE</span></div><div class="toolbar"><input id="search" type="search" placeholder="Search projects or equipment…" aria-label="Search projects or equipment" /><select id="classification" aria-label="Filter projects"><option value="ALL">ALL</option><option value="ACTIVE">CURRENT</option><option value="VISION">FUTURE</option></select></div><div id="project-list">
{projects.map((project, i) => <article class="project-block" data-project={project.name.toLowerCase()} data-classification={project.classification}><header><div><div class="eyebrow">{String(i + 1).padStart(2, '0')}</div><h3>{project.name}</h3><div class="project-meta">{project.phase}</div></div><span class="pill">{project.classification === 'VISION' ? 'FUTURE' : project.phase_group === 'PHASE_1' ? 'PHASE 1' : 'CURRENT'}</span></header>
{project.id !== 'church-building' && project.items.map((item) => <div class="component" data-search={`${item.name} ${item.product} ${item.notes}`.toLowerCase()}><div class="component-grid"><div><h4>{item.name}</h4><div class="product">{item.product}</div>{item.notes && <p class="small">{item.notes}</p>}<div class="specs"><span class="spec">{item.qty ?? '—'} ×</span>{item.priority && <span class="spec">{item.priority}</span>}</div>{item.budget_inr != null && <div style="margin-top:18px"><div class="eyebrow">Planned amount</div><div class="money">{fmt(item.budget_inr)}</div></div>}{item.image_url && <div style="margin-top:18px"><img class="component-source-image" src={item.image_url} alt={item.name} loading="lazy" referrerpolicy="no-referrer" /></div>}</div><div>
{(productByComponent[item.id] ?? []).length === 2 ? <><div class="eyebrow">CHOOSE BETWEEN THE LISTED OPTIONS</div><div class="alternatives">{productByComponent[item.id].map((p) => <article class="alternative"><img src={p.image_url} alt={`${p.manufacturer} ${p.model}`} loading="lazy" referrerpolicy="no-referrer" /><div class="alternative-body"><h5>{p.manufacturer}<br />{p.model}</h5><span class="pill">ALTERNATIVE</span><details><summary>SEE KEY DIFFERENCES</summary><ul>{Object.entries(p.verified_specs ?? {}).filter(([k]) => k !== 'differentiator').map(([k,v]) => <li><strong>{k.replaceAll('_',' ')}:</strong> {v}</li>)}{p.verified_specs?.differentiator && <li><strong>Why it may suit:</strong> {p.verified_specs.differentiator}</li>}</ul></details><div class="source"><a href={p.source} target="_blank" rel="noreferrer">VIEW PRODUCT ↗</a></div></div></article>)}</div></> : (productByComponent[item.id] ?? []).map((p) => <div class="product-single"><img src={p.image_url} alt={`${p.manufacturer} ${p.model}`} loading="lazy" referrerpolicy="no-referrer" /><h5>{p.manufacturer} / {p.model}</h5><div class="specs">{Object.entries(p.verified_specs ?? {}).map(([k,v]) => <span class="spec">{k.replaceAll('_',' ')}: {v}</span>)}</div><div class="source"><a href={p.source} target="_blank" rel="noreferrer">VIEW PRODUCT ↗</a></div></div>)}</div></div></div>)}</article>)}
</div><div id="empty" class="empty" hidden>No matching project or equipment found.</div></section>

<section class="section project-section" id="building"><div class="section-head"><div><div class="eyebrow">GRACE CHAPEL KANNURU CAMPUS</div><h2>CHURCH BUILDING</h2></div><span class="mono muted">SPACE / CARE / WELCOME</span></div><p class="funding-intro">The building work is about making the church a better place to worship, serve, teach and welcome people. You can help with a complete area or contribute towards a particular part of it.</p>{churchGroups.map((group) => <article class="church-group"><header><div class="eyebrow">CHURCH BUILDING</div><h3>{group.title}</h3><p class="small">{group.subtitle}</p></header><div class="material-grid">{group.items.map((item) => <div class="material">{item.image_url && <img src={item.image_url} alt={item.name} loading="lazy" referrerpolicy="no-referrer" />}<h4>{item.name}</h4><p class="small">{item.product}</p>{item.budget_inr != null && <div class="price">{fmt(item.budget_inr)}</div>}{item.notes && <p class="small">{item.notes}</p>}</div>)}</div></article>)}</section>

<section class="section project-section" id="future"><div class="section-head"><div><div class="eyebrow">LOOKING AHEAD</div><h2>FUTURE PROJECTS</h2></div><span class="mono muted">LIMITLESS</span></div><p class="funding-intro">Future phases are shown separately. The source lists these projects without costs, so no future-phase amount is invented here.</p><div class="future-grid">{(projects.find((p) => p.id === 'future-projects')?.items ?? []).map((item) => <article class="future-card"><div class="eyebrow">FUTURE</div><h3>{item.name}</h3><p class="small">{item.notes}</p></article>)}</div></section>
<section class="section cta project-section" id="involvement"><div><div class="eyebrow">PRAYERFULLY CONSIDER</div><h2>COULD YOU HELP?</h2><p class="body-copy">If the Lord leads you, you are welcome to consider funding part of a project, funding an entire project, giving equipment, volunteering your skills, or simply praying with us for the work.</p></div><div class="button-row"><a class="button primary" href="mailto:info@gracechapel.org.in?subject=Plans%20%26%20Projects%20-%20I%20would%20like%20to%20help">I WOULD LIKE TO HELP →</a><a class="button" href="https://www.gracechapel.org.in/" target="_blank" rel="noreferrer">VISIT GRACE CHAPEL ↗</a></div></section>
<script>
const search=document.querySelector('#search');const classification=document.querySelector('#classification');const empty=document.querySelector('#empty');const blocks=[...document.querySelectorAll('.project-block[data-project]')];
function filterProjects(){const q=(search?.value||'').trim().toLowerCase();const c=classification?.value||'ALL';let visible=0;blocks.forEach((block)=>{const classMatch=c==='ALL'||block.dataset.classification===c;const textMatch=!q||block.dataset.project.includes(q)||[...block.querySelectorAll('[data-search]')].some((item)=>item.dataset.search.includes(q));const show=classMatch&&textMatch;block.hidden=!show;if(show)visible++});if(empty)empty.hidden=visible!==0}search?.addEventListener('input',filterProjects);classification?.addEventListener('change',filterProjects);
</script>
</BaseLayout>
