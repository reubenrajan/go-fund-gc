---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/projects.json';
import funding from '../data/funding.json';
import { formatInr, financialProgress } from '../lib/progress.js';
const base = import.meta.env.BASE_URL;
const active = data.projects.filter(p => p.classification !== 'VISION');
const pricedItems = active.flatMap(p => p.items).filter(x => x.budget_inr != null);
const knownScope = pricedItems.reduce((sum, x) => sum + x.budget_inr, 0);
const funded = Object.values(funding.components ?? {}).reduce((sum, x) => sum + (Number.isFinite(x.raised_inr) ? x.raised_inr : 0), 0);
const hasFunding = funding.status === 'CONNECTED';
const percentage = hasFunding ? financialProgress(knownScope, funded) : null;
---
<BaseLayout title="Grace Chapel — Plans & Projects" description="Grace Chapel Kannuru Plans & Projects — projects, components, product research and transparent programme information.">
<section class="hero">
  <div class="eyebrow">001 / KANNURU CAMPUS / PROGRAMME SYSTEM</div>
  <div class="hero-grid"><div><h1>SEE THE BUILDING.<br />UNDERSTAND THE PROJECT.</h1><p class="lede">A project-first view of the Grace Chapel Kannuru programme. Explore equipment, building work, priorities and the evidence behind each requirement.</p></div><div class="hero-mark" aria-hidden="true"><div class="crosshair"></div><span>GC / K</span></div></div>
  <div class="hero-actions"><a class="button primary" href={`${base}projects/`}>EXPLORE PROJECTS →</a><a class="button" href={`${base}building/`}>VIEW CAMPUS →</a></div>
</section>
<section class="section"><div class="section-head"><div class="eyebrow">PROGRAMME DASHBOARD</div><span class="mono muted">LIVE DATA MODEL</span></div><div class="metrics">
  <div class="metric"><div class="label">Programme areas</div><div class="value">{data.projects.length}</div><div class="muted">Active systems, building work and future vision</div></div>
  <div class="metric"><div class="label">Components</div><div class="value">{data.projects.reduce((n,p)=>n+p.items.length,0)}</div><div class="muted">Defined requirements</div></div>
  <div class="metric"><div class="label">Known priced scope</div><div class="value">{formatInr(knownScope)}</div><div class="muted">Excludes unpriced requirements and vision-only scope</div></div>
  <div class="metric"><div class="label">Funding feed</div><div class="value">{hasFunding ? `${percentage}%` : 'NOT CONNECTED'}</div><div class="muted">Donor-level data remains private</div></div>
</div></section>
<section class="section"><div class="section-head"><div><div class="eyebrow">PROJECT REGISTER / 01–08</div><h2>THE PROGRAMME</h2></div><a class="text-link" href={`${base}projects/`}>ALL PROJECTS →</a></div><div class="project-grid">
{data.projects.map((project, i) => <a class="project-card" href={`${base}projects/${project.id}/`}><div class="card-top"><span class="tag">{String(i+1).padStart(2,'0')}</span><span class="status">{project.classification}</span></div><div><h3>{project.name}</h3><p>{project.phase}</p></div><div class="card-foot"><span>{project.items.length} COMPONENTS</span><span>→</span></div></a>)}
</div></section>
<section class="section split"><div><div class="eyebrow">02 / COMPONENT MODEL</div><h2>ONE REQUIREMENT.<br />ONE TRACEABLE UNIT.</h2></div><div><p class="body-copy">Every component can carry a product, manufacturer, model, quantity, budget, source, research confidence and progress state. Alternatives stay alternatives until selection is confirmed.</p><a class="text-link" href={`${base}components/`}>OPEN COMPONENT REGISTER →</a></div></section>
<section class="section split"><div><div class="eyebrow">03 / FINANCIAL TRANSPARENCY</div><h2>FINANCIAL TRUTH<br />BEFORE POLISH.</h2></div><div><p class="body-copy">Known budgets are preserved from the source inventory. Funding is shown only when connected to an approved public aggregate feed. Unknown is never silently converted to zero.</p><a class="text-link" href={`${base}transparency/`}>OPEN TRANSPARENCY →</a></div></section>
<section class="section cta"><div><div class="eyebrow">04 / GET INVOLVED</div><h2>BUILD A PIECE<br />OF THE WORK.</h2><p class="body-copy">Support a defined component, support a project, give equipment, volunteer or connect with Grace Chapel.</p></div><a class="button primary" href={`${base}get-involved/`}>SEE HOW TO HELP →</a></section>
</BaseLayout>
