---
import BaseLayout from '../layouts/BaseLayout.astro';
import projectData from '../data/projects.json';
import productData from '../data/products.json';
import funding from '../data/funding.json';
import { formatInr } from '../lib/progress.js';

const projects = projectData.projects;
const products = productData.products;
const pricedItems = projects.flatMap(p => p.items).filter(x => x.budget_inr != null);
const componentCount = projects.reduce((n, p) => n + p.items.length, 0);
const priorityCount = projects.flatMap(p => p.items).filter(x => x.priority === 'PRIORITY').length;
const researchCount = products.length;
const scope = funding.summary?.known_priced_component_scope_inr ?? pricedItems.reduce((sum, x) => sum + x.budget_inr, 0);
const raised = funding.summary?.confirmed_funding_inr ?? 0;
const expenditure = funding.summary?.approved_expenditure_inr ?? 0;
const remaining = funding.summary?.remaining_against_known_priced_scope_inr ?? Math.max(scope - raised, 0);
const completion = funding.summary?.financial_completion_percent ?? 0;
const fmt = (v) => formatInr(v);
---
<BaseLayout title="Grace Chapel — Plans & Projects" description="Single-page project, component, research and financial view for the Grace Chapel Kannuru campus.">
<style>
  .spa-nav{position:sticky;top:0;z-index:20;background:#000;border-bottom:1px solid #292929;padding:10px 0;display:flex;gap:8px;overflow:auto}.spa-nav a{white-space:nowrap;border:1px solid #333;padding:8px 10px;font:10px ui-monospace,SFMono-Regular,Menlo,monospace;text-decoration:none;color:#aaa}.spa-nav a:hover,.spa-nav a:focus{background:#fff;color:#000}.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}.toolbar input,.toolbar select{background:#000;color:#fff;border:1px solid #444;padding:12px;font:12px ui-monospace,SFMono-Regular,Menlo,monospace}.toolbar input{min-width:260px;flex:1}.project-section{scroll-margin-top:80px}.project-block{border:1px solid #292929;margin:18px 0;background:#000}.project-block>header{padding:20px;border-bottom:1px solid #292929;display:flex;justify-content:space-between;gap:20px;align-items:start}.project-block h3{font-size:32px;margin:0 0 8px;letter-spacing:-.04em}.project-meta{font:10px ui-monospace,SFMono-Regular,Menlo,monospace;color:#999;text-transform:uppercase}.component{border-bottom:1px solid #202020;padding:20px}.component:last-child{border-bottom:0}.component-grid{display:grid;grid-template-columns:1.4fr .8fr .7fr;gap:20px}.component h4{font-size:20px;margin:0 0 8px}.component .product{color:#bbb;margin-bottom:8px}.specs{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}.spec{border:1px solid #333;padding:5px 7px;font:10px ui-monospace,SFMono-Regular,Menlo,monospace;color:#aaa}.money{font:24px ui-monospace,SFMono-Regular,Menlo,monospace}.small{font-size:12px;color:#999;line-height:1.5}.research{border-left:2px solid #333;padding-left:14px;margin-top:12px}.source{font:10px ui-monospace,SFMono-Regular,Menlo,monospace;word-break:break-all;color:#888}.source a{color:#aaa}.pill{font:10px ui-monospace,SFMono-Regular,Menlo,monospace;border:1px solid #444;padding:5px 7px;color:#aaa}.data-note{border:1px solid #292929;padding:18px;color:#aaa;font-size:13px;line-height:1.55}.product-grid{grid-template-columns:repeat(3,1fr)}.product-card{background:#000;border:1px solid #292929;padding:20px}.product-card h3{font-size:22px;margin:10px 0 5px}.progress{height:5px;background:#222;margin:12px 0}.progress>span{display:block;height:100%;background:#fff}.empty{padding:30px;border:1px dashed #333;color:#888}.topline{display:flex;justify-content:space-between;gap:20px;align-items:end}.source-label{font:10px ui-monospace,SFMono-Regular,Menlo,monospace;color:#777}.footnote{font-size:11px;color:#777;line-height:1.5}
  @media(max-width:900px){.component-grid,.product-grid{grid-template-columns:1fr}.project-block>header{display:block}.project-block>header .pill{display:inline-block;margin-top:10px}}
</style>

<section class="hero" id="top">
  <div class="eyebrow">001 / KANNURU CAMPUS / SINGLE-PAGE PROGRAMME SYSTEM</div>
  <div class="hero-grid">
    <div>
      <h1>SEE THE BUILDING.<br />UNDERSTAND THE PROJECT.</h1>
      <p class="lede">The complete Grace Chapel Plans & Projects register in one page: projects, components, budgets, priorities, product research, financial status and future vision.</p>
    </div>
    <div class="hero-mark" aria-hidden="true"><div class="crosshair"></div><span>GC / K</span></div>
  </div>
</section>

<nav class="spa-nav" aria-label="Page sections">
  <a href="#dashboard">DASHBOARD</a><a href="#projects">PROJECTS</a><a href="#components">COMPONENTS</a><a href="#research">RESEARCH</a><a href="#finance">FINANCE</a><a href="#future">FUTURE</a><a href="#involvement">GET INVOLVED</a>
</nav>

<section class="section" id="dashboard">
  <div class="section-head"><div><div class="eyebrow">PROGRAMME DASHBOARD</div><h2>ONE SOURCE OF TRUTH.</h2></div><span class="mono muted">DATA {funding.last_updated ?? '—'}</span></div>
  <div class="metrics">
    <div class="metric"><div class="label">Programme areas</div><div class="value">{projects.length}</div><div class="muted">Active systems, building work and future vision</div></div>
    <div class="metric"><div class="label">Components</div><div class="value">{componentCount}</div><div class="muted">Defined requirements</div></div>
    <div class="metric"><div class="label">Known priced scope</div><div class="value">{fmt(scope)}</div><div class="muted">Spreadsheet aggregate</div></div>
    <div class="metric"><div class="label">Financial completion</div><div class="value">{completion}%</div><div class="muted">Confirmed funding against known priced scope</div></div>
  </div>
  <div class="facts" style="margin-top:1px">
    <div class="fact"><div class="k">Confirmed funding</div><div class="v price">{fmt(raised)}</div></div>
    <div class="fact"><div class="k">Approved expenditure</div><div class="v price">{fmt(expenditure)}</div></div>
    <div class="fact"><div class="k">Remaining</div><div class="v price">{fmt(remaining)}</div></div>
    <div class="fact"><div class="k">Priority components</div><div class="v price">{priorityCount}</div></div>
  </div>
  <p class="footnote">Funding status: {funding.status}. {funding.public_note}</p>
</section>

<section class="section project-section" id="projects">
  <div class="section-head"><div><div class="eyebrow">PROJECT REGISTER / 01–08</div><h2>THE PROGRAMME</h2></div><span class="mono muted">ALL DETAILS INLINE</span></div>
  <div class="toolbar" aria-label="Project filters"><input id="search" type="search" placeholder="SEARCH PROJECTS, COMPONENTS OR PRODUCTS…" aria-label="Search the programme" /><select id="classification" aria-label="Filter by classification"><option value="ALL">ALL CLASSIFICATIONS</option><option value="ACTIVE">ACTIVE</option><option value="VISION">VISION</option></select></div>
  <div id="project-list">
    {projects.map((project, i) => <article class="project-block" data-project={project.name.toLowerCase()} data-classification={project.classification}>
      <header><div><div class="eyebrow">{String(i+1).padStart(2,'0')} / {project.classification}</div><h3>{project.name}</h3><div class="project-meta">{project.phase} · {project.items.length} components</div></div><span class="pill">{project.classification}</span></header>
      {project.items.map((item) => <div class="component" data-search={`${item.name} ${item.product} ${item.notes}`.toLowerCase()}>
        <div class="component-grid">
          <div><h4>{item.name}</h4><div class="product">{item.product}</div><div class="small">ID: <span class="mono">{item.id}</span></div>{item.notes && <div class="small">{item.notes}</div>}
            <div class="specs"><span class="spec">QTY {item.qty ?? '—'}</span>{item.priority && <span class="spec">{item.priority}</span>}<span class="spec">{item.confidence}</span></div>
          </div>
          <div><div class="label">Budget</div><div class="money">{item.budget_inr != null ? fmt(item.budget_inr) : '—'}</div><div class="small">Unknown values remain unknown.</div></div>
          <div><div class="label">Research</div>{products.filter(p => p.component_id === item.id).map(p => <div class="research"><div><span class="pill">{p.status}</span> <span class="pill">{p.confidence}</span></div><div class="small">{p.manufacturer}<br />{p.model}</div><div class="specs">{Object.entries(p.verified_specs ?? {}).map(([k,v]) => <span class="spec">{k}: {v}</span>)}</div><div class="source"><a href={p.source} target="_blank" rel="noreferrer">SOURCE ↗</a></div></div>)}{!products.some(p => p.component_id === item.id) && <div class="small">No product research record.</div>}</div>
        </div>
      </div>)}
    </article>)}
  </div>
  <div id="empty" class="empty" hidden>No matching project or component.</div>
</section>

<section class="section project-section" id="components">
  <div class="section-head"><div><div class="eyebrow">COMPONENT REGISTER</div><h2>TRACEABLE UNITS.</h2></div><span class="mono muted">{componentCount} COMPONENTS</span></div>
  <div class="grid">
    {projects.flatMap(p => p.items.map(item => ({...item, project:p.name, classification:p.classification}))).map(item => <div class="card"><div class="card-top"><span class="tag">{item.id}</span><span class="status">{item.classification}</span></div><div><h3>{item.name}</h3><p>{item.project}</p><p>{item.product}</p></div><div class="card-foot"><span>{item.budget_inr != null ? fmt(item.budget_inr) : 'UNPRICED'}</span><span>{item.priority ?? 'NORMAL'}</span></div></div>)}
  </div>
</section>

<section class="section project-section" id="research">
  <div class="section-head"><div><div class="eyebrow">PRODUCT RESEARCH</div><h2>VERIFIED WHERE POSSIBLE.</h2></div><span class="mono muted">{researchCount} RESEARCH RECORDS</span></div>
  <div class="grid product-grid">
    {products.map(p => <article class="product-card"><div class="card-top"><span class="pill">{p.status}</span><span class="status">{p.confidence}</span></div><h3>{p.manufacturer} / {p.model}</h3><p class="small">Component: {p.component_id}</p><div class="specs">{Object.entries(p.verified_specs ?? {}).map(([k,v]) => <span class="spec">{k}: {v}</span>)}</div><p class="source"><a href={p.source} target="_blank" rel="noreferrer">OFFICIAL SOURCE ↗</a></p></article>)}
  </div>
</section>

<section class="section project-section" id="finance">
  <div class="section-head"><div><div class="eyebrow">FINANCIAL TRANSPARENCY</div><h2>THE NUMBERS.</h2></div><span class="mono muted">PUBLIC AGGREGATES ONLY</span></div>
  <div class="detail-grid">
    <div class="panel"><h2>Funding snapshot</h2><div class="facts"><div class="fact"><div class="k">Known priced component scope</div><div class="v price">{fmt(scope)}</div></div><div class="fact"><div class="k">Confirmed funding</div><div class="v price">{fmt(raised)}</div></div><div class="fact"><div class="k">Remaining</div><div class="v price">{fmt(remaining)}</div></div><div class="fact"><div class="k">Completion</div><div class="v price">{completion}%</div></div></div><div class="progress"><span style={`width:${Math.min(100, Math.max(0, completion))}%`}></span></div></div>
    <div class="panel"><h2>Source</h2><p class="small">Last imported: {funding.last_updated ?? '—'}</p><p class="source"><a href={funding.source_url} target="_blank" rel="noreferrer">OPEN FINANCIAL WORKBOOK ↗</a></p><p class="data-note">No donor-level transactions are published. The public site carries aggregate values only.</p></div>
  </div>
</section>

<section class="section project-section" id="future">
  <div class="section-head"><div><div class="eyebrow">FUTURE PROJECTS / LIMITLESS</div><h2>VISION.</h2></div><span class="mono muted">{projects.find(p => p.id === 'future-projects')?.items.length ?? 0} ITEMS</span></div>
  <div class="grid">{(projects.find(p => p.id === 'future-projects')?.items ?? []).map(item => <div class="card"><div class="card-top"><span class="tag">VISION</span><span class="status">FUTURE</span></div><div><h3>{item.name}</h3><p>{item.product}</p><p class="small">{item.notes}</p></div><div class="card-foot"><span>NOT PRICED</span><span>—</span></div></div>)}</div>
</section>

<section class="section cta project-section" id="involvement"><div><div class="eyebrow">GET INVOLVED</div><h2>BUILD A PIECE<br />OF THE WORK.</h2><p class="body-copy">Support a defined component, support a project, give equipment, volunteer or connect with Grace Chapel.</p></div><div class="hero-actions"><a class="button primary" href="mailto:info@gracechapel.org.in">CONTACT GRACE CHAPEL →</a><a class="button" href="#projects">EXPLORE PROJECTS ↑</a></div></section>

<script type="application/json" id="gc-data" set:html={JSON.stringify({projects, products, funding})}></script>
<script>
  const search = document.querySelector('#search');
  const classification = document.querySelector('#classification');
  const empty = document.querySelector('#empty');
  const blocks = [...document.querySelectorAll('.project-block[data-project]')];
  function filter(){
    const q = (search?.value || '').trim().toLowerCase();
    const c = classification?.value || 'ALL';
    let visible = 0;
    blocks.forEach(block => {
      const matchClass = c === 'ALL' || block.dataset.classification === c;
      const matchText = !q || block.dataset.project.includes(q) || [...block.querySelectorAll('.component')].some(x => x.dataset.search.includes(q));
      const show = matchClass && matchText;
      block.hidden = !show;
      if(show) visible++;
    });
    if(empty) empty.hidden = visible !== 0;
  }
  search?.addEventListener('input', filter);
  classification?.addEventListener('change', filter);
</script>
</BaseLayout>
