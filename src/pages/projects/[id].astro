---
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../data/projects.json';
import funding from '../../data/funding.json';
import { formatInr, financialProgress } from '../../lib/progress.js';
export function getStaticPaths() { return data.projects.map(project => ({ params: { id: project.id } })); }
const project = data.projects.find(p => p.id === Astro.params.id);
if (!project) throw new Error(`Unknown project: ${Astro.params.id}`);
const base = import.meta.env.BASE_URL;
const priced = project.items.filter(x => x.budget_inr != null);
const total = priced.reduce((sum, x) => sum + x.budget_inr, 0);
const raised = project.items.reduce((sum, item) => sum + (Number.isFinite(funding.components?.[item.id]?.raised_inr) ? funding.components[item.id].raised_inr : 0), 0);
const funded = funding.status === 'CONNECTED' ? financialProgress(total, raised) : null;
---
<BaseLayout title={`${project.name} — Grace Chapel Plans & Projects`}>
<section class="detail-head"><div class="eyebrow">PROJECT / {project.id}</div><h1>{project.name}</h1><p class="muted">{project.phase} · {project.classification}</p></section>
<section class="detail-grid"><div class="panel"><h2>Components</h2><table><thead><tr><th>Component</th><th>Product / material</th><th>Budget</th><th>State</th></tr></thead><tbody>{project.items.map((item) => <tr><td><a href={`${base}components/${item.id}/`}>{item.name}</a></td><td>{item.product}<br/><span class="muted">{item.notes}</span></td><td>{formatInr(item.budget_inr)}</td><td><span class="tag">{item.priority || 'NORMAL'}</span></td></tr>)}</tbody></table></div><aside class="panel"><h2>Known priced scope</h2><div class="price">{formatInr(total)}</div><p class="muted">Sum of priced component lines currently in the canonical inventory. This is not a confirmed fundraising target.</p><h2 style="margin-top:36px">Funding</h2><div class="price">{funded == null ? 'NOT CONNECTED' : `${funded}%`}</div><p class="muted">Funding completion is displayed only when the public aggregate feed is connected.</p></aside></section>
</BaseLayout>
